# Copy this file to .env and fill in your values:
#   cp .env.template .env
#
# After copying, install the package (and the TUI dependencies):
#   pip install -e .
#   cd frontend/opentui && bun install

# --- API Configuration ---
OPENAI_API_KEY=sk-your-deepseek-key-here
OPENAI_BASE_URL=https://api.deepseek.com
HARNESS_MODEL=deepseek-flash
HARNESS_MODEL_INTENSITY=hard
# HARNESS_MODEL_FAST=deepseek-flash
# HARNESS_MODEL_NORMAL=deepseek-flash
# HARNESS_MODEL_HARD=deepseek-v4-pro
# HARNESS_MODEL_MAX=deepseek-v4-pro
# HARNESS_PROVIDER=auto
# HARNESS_STREAM=auto
# text: text/code plus PDF/DOCX through built-in skills; multimodal additionally sends JPEG/PNG/GIF/WebP images to the endpoint.
# HARNESS_MODEL_INPUT_MODE=text
# workspace-write (default), read-only, llm-auto, danger-full-access, terminal-eval.
# HARNESS_PERMISSION_MODE=workspace-write
# Windows uses PowerShell 7 with the bundled native directory write sandbox.

# --- Memory embeddings (independent credential) ---
SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# Model: BAAI/bge-m3; 1024 dimensions.
# HARNESS_MEMORY_ROOT=       # default: ~/.harness/memory-v3
# HARNESS_MEMORY_DISABLED=0
# HARNESS_MEMORY_GENERATION_DISABLED=0

# --- Shell process limits ---
# POSIX host resource limits applied between fork and exec via setrlimit (0 = disabled):
# HARNESS_SHELL_MEMORY_KB=0      # RLIMIT_AS, address space; can false-kill JVM/Node
# HARNESS_SHELL_CPU_SECONDS=0    # RLIMIT_CPU, CPU seconds
# HARNESS_SHELL_FSIZE_BLOCKS=0   # RLIMIT_FSIZE, max single-file size in 512B blocks
# Shell output is drained continuously (commands are never interrupted for
# printing too much); only a head+tail preview of this many chars stays in
# memory, larger output is streamed to an artifact file.
# HARNESS_SHELL_OUTPUT_PREVIEW_CHARS=8192
# Lifecycle of a shell job: after a foreground command exits, surviving
# descendants get the drain window and are then terminated; reader threads are
# joined only for a bounded time. Background jobs follow their descendants.
# HARNESS_SHELL_JOB_EXIT_DRAIN_SECONDS=2
# HARNESS_SHELL_JOB_TERMINATION_CONFIRM_SECONDS=3
# HARNESS_SHELL_JOB_READER_JOIN_SECONDS=5

# --- Runtime Safety Nets ---
# There is no global per-tool timeout; each backend owns its own.
# HARNESS_SHELL_DEFAULT_TIMEOUT_SECONDS=300  # run_bash default timeout
# HARNESS_TOOL_MAX_TIMEOUT_SECONDS=1800      # run_bash timeout ceiling (kills process tree)
# HARNESS_LLM_REQUEST_TIMEOUT_SECONDS=300    # non-streaming assistant request timeout
# HARNESS_LLM_MAX_RETRIES=2                  # channel-level retries for 429/5xx/connection (SDK retries disabled)
# HARNESS_LLM_STREAM_IDLE_TIMEOUT_SECONDS=60 # max idle gap between streamed chunks
# HARNESS_MAX_CONCURRENT_AGENTS=3
# HARNESS_MAX_OPEN_AGENTS=8
# HARNESS_WORKSPACE_WRITE_QUOTA_MB=0         # session quota for write_file/apply_patch bytes; 0 = unlimited
# HARNESS_MIN_FREE_DISK_MB=100               # structured writes fail below this free-space margin

# --- MCP Client ---
# Configure MCP servers per workspace in .harness/mcp.json.
# Secret values in that file can reference environment variables such as ${DOCS_MCP_TOKEN}.
# DOCS_MCP_TOKEN=

# --- Agent Budgets (per-turn limits) ---
# MAX_AGENT_TOTAL_TOKENS and MAX_AGENT_TOOL_CALLS apply per user turn (not per
# session). Exceeding either triggers an agent fallback. There is no iteration
# cap: turns are bounded by resources, side effects, and cancellation.
# HARNESS_CONTEXT_WINDOW_TOKENS=200000
# COMPRESS_THRESHOLD=180000
# MAX_AGENT_TOTAL_TOKENS=0
# MAX_AGENT_TOOL_CALLS=200
# AGENT_BUDGET_WARN_FRACTION=0.8
