# Copy this file to .env and fill in your values:
#   cp .env.template .env
#
# After installing requirements, also install Playwright browsers:
#   pip install -r requirements.txt
#   python -m playwright install chromium

# --- API Configuration ---
OPENAI_API_KEY=sk-your-deepseek-key-here
OPENAI_BASE_URL=https://api.deepseek.com
HARNESS_MODEL=deepseek-v4-flash
HARNESS_MODEL_INTENSITY=hard
# HARNESS_MODEL_FAST=deepseek-v4-flash
# HARNESS_MODEL_NORMAL=deepseek-v4-flash
# HARNESS_MODEL_HARD=deepseek-v4-pro
# HARNESS_MODEL_MAX=deepseek-v4-pro
# HARNESS_PROVIDER=auto
# HARNESS_STREAM=auto
# text: text/code plus PDF/DOCX through built-in skills; multimodal additionally sends JPEG/PNG/GIF/WebP images to the endpoint.
# HARNESS_MODEL_INPUT_MODE=text
# Required Windows host-shell choice: pwsh or wsl. Selection is strict; there is no fallback.
HARNESS_WINDOWS_SHELL=pwsh

# --- Shell Sandbox ---
# host: run shell commands on the host; docker: run run_bash inside a Docker container.
# HARNESS_SANDBOX_MODE=host
# HARNESS_DOCKER_IMAGE=python:3.12
# HARNESS_DOCKER_NETWORK=none
# HARNESS_DOCKER_USER=         # empty: auto UID/GID on POSIX, no mapping on Windows.
#                               # non-empty: passed as --user, e.g. "1000:1000".
# Docker sandbox resource limits (0 = leave the docker flag unset):
# HARNESS_DOCKER_MEMORY_MB=2048  # docker run --memory
# HARNESS_DOCKER_CPUS=2          # docker run --cpus
# POSIX host resource limits injected via ulimit before each command (0 = disabled):
# HARNESS_SHELL_MEMORY_KB=0      # ulimit -v, address space; can false-kill JVM/Node
# HARNESS_SHELL_CPU_SECONDS=0    # ulimit -t, CPU seconds
# HARNESS_SHELL_FSIZE_BLOCKS=0   # ulimit -f, max single-file size in 512B blocks
# Raw foreground command output capture ceiling; the command is interrupted once
# its output exceeds this many bytes (0 = no cap):
# HARNESS_SHELL_MAX_OUTPUT_BYTES=10485760

# --- Runtime Safety Nets ---
# HARNESS_TOOL_DEFAULT_TIMEOUT_SECONDS=300  # per-call deadline for tools without their own timeout
# HARNESS_TOOL_MAX_TIMEOUT_SECONDS=1800      # hard ceiling for tool-supplied timeouts (e.g. run_bash)
# HARNESS_LLM_REQUEST_TIMEOUT_SECONDS=300    # non-streaming assistant request timeout
# HARNESS_LLM_MAX_RETRIES=2                  # bounded transport retries (429/5xx/connection)
# HARNESS_LLM_STREAM_IDLE_TIMEOUT_SECONDS=60 # max idle gap between streamed chunks
# HARNESS_MAX_CONCURRENT_AGENTS=3
# HARNESS_MAX_OPEN_AGENTS=8
# HARNESS_WORKSPACE_WRITE_QUOTA_MB=0         # session quota for write_file/apply_patch bytes; 0 = unlimited
# HARNESS_MIN_FREE_DISK_MB=100               # structured writes fail below this free-space margin

# --- MCP Client ---
# Configure MCP servers per workspace in .harness/mcp.json.
# Secret values in that file can reference environment variables such as ${DOCS_MCP_TOKEN}.
# DOCS_MCP_TOKEN=

# --- Git Checkpoints ---
# none: keep only the initial init commit
# checkpoint: commit a restore point for new committable changes from each turn
# milestone: commit successful sessions as task milestones
HARNESS_COMMIT_POLICY=checkpoint

# --- Agent Budgets (per-turn limits) ---
# Each of MAX_AGENT_ITERATIONS, MAX_AGENT_TOTAL_TOKENS, and MAX_AGENT_TOOL_CALLS
# applies per user turn (not per session). Exceeding any triggers an agent fallback.
# MAX_HARNESS_ROUNDS=5
# PASS_THRESHOLD=7.0
# HARNESS_CONTEXT_WINDOW_TOKENS=200000
# COMPRESS_THRESHOLD=180000
# SUMMARY_TARGET_THRESHOLD=150000
# MAX_AGENT_ITERATIONS=60
# MAX_AGENT_TOTAL_TOKENS=0
# MAX_AGENT_TOOL_CALLS=200
# AGENT_BUDGET_WARN_FRACTION=0.8
